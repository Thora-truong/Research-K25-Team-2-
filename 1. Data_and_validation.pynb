    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Cấu hình hiển thị Matplotlib\n",
        "plt.style.use('seaborn-v0_8-whitegrid' if 'seaborn-v0_8-whitegrid' in plt.style.available else 'default')\n",
        "plt.rcParams['font.sans-serif'] = 'DejaVu Sans'\n",
        "plt.rcParams['axes.edgecolor'] = '#cccccc'\n",
        "plt.rcParams['axes.linewidth'] = 0.8\n",
        "\n",
        "# Tạo thư mục lưu kết quả\n",
        "os.makedirs('processed', exist_ok=True)\n",
        "os.makedirs('figures', exist_ok=True)\n",
        "\n",
        "# 1. LOAD DATASET\n",
        "df_branch = pd.read_excel('processed/Processed_Branch_Master.xlsx')\n",
        "df_outbound = pd.read_excel('Research_Project_Data.xlsx', sheet_name='Outbound')\n",
        "df_cost = pd.read_excel('Research_Project_Data.xlsx', sheet_name='CostCurve')\n",
        "df_scenario = pd.read_excel('Research_Project_Data.xlsx', sheet_name='CurrentScenario')\n",
        "\n",
        "# 2. EDA\n",
        "# 2.1 Pareto Analysis of Branch Demand (80/20 Rule)\n",
        "df_pareto = df_branch.sort_values(by='total_cbm', ascending=False).reset_index(drop=True)\n",
        "df_pareto['cum_cbm'] = df_pareto['total_cbm'].cumsum()\n",
        "df_pareto['cum_pct'] = (df_pareto['cum_cbm'] / df_pareto['total_cbm'].sum()) * 100\n",
        "df_pareto['branch_pct'] = ((df_pareto.index + 1) / len(df_pareto)) * 100\n",
        "\n",
        "top_20_idx = int(len(df_pareto) * 0.20)\n",
        "cbm_top_20_pct = df_pareto.loc[top_20_idx, 'cum_pct']\n",
        "\n",
        "# Biểu đồ Pareto\n",
        "fig, ax1 = plt.subplots(figsize=(10, 5))\n",
        "ax2 = ax1.twinx()\n",
        "\n",
        "ax1.bar(df_pareto.index, df_pareto['total_cbm'], color='#1f77b4', alpha=0.6, width=1.0, label='Branch CBM')\n",
        "ax2.plot(df_pareto.index, df_pareto['cum_pct'], color='#d62728', linewidth=2, label='Cumulative %')\n",
        "\n",
        "ax2.axhline(80, color='gray', linestyle='--', linewidth=1)\n",
        "ax2.axvline(top_20_idx, color='gray', linestyle='--', linewidth=1)\n",
        "\n",
        "ax1.set_xlabel('Branch Rank (Sorted by CBM Volume)', fontsize=11)\n",
        "ax1.set_ylabel('Total CBM per Branch', fontsize=11, color='#1f77b4')\n",
        "ax2.set_ylabel('Cumulative Percentage (%)', fontsize=11, color='#d62728')\n",
        "plt.title(f'Pareto Chart of Branch Demand (Top 20% Branches = {cbm_top_20_pct:.1f}% CBM)', fontsize=13, fontweight='bold', pad=12)\n",
        "plt.tight_layout()\n",
        "plt.savefig('figures/eda_pareto_cbm.png', dpi=300)\n",
        "plt.close()\n",
        "\n",
        "# 2.2 Demand Breakdown by State\n",
        "state_summary = (\n",
        "    df_branch.groupby(\"State\")\n",
        "    .agg(\n",
        "        branch_count=(\"DestinationRef\", \"count\"),\n",
        "        total_cbm=(\"total_cbm\", \"sum\"),\n",
        "        total_kg=(\"total_kg\", \"sum\"),\n",
        "    )\n",
        "    .reset_index()\n",
        "    .sort_values(by=\"total_cbm\", ascending=False)\n",
        ")\n",
        "state_summary[\"cbm_share_pct\"] = (\n",
        "    state_summary[\"total_cbm\"] / state_summary[\"total_cbm\"].sum()\n",
        ") * 100\n",
        "\n",
        "# 2.3 Demand Breakdown by Product Section\n",
        "section_summary = (\n",
        "    df_outbound.groupby(\"Section\")\n",
        "    .agg(\n",
        "        total_cbm=(\"BranchDeliveryVolumeInCBM\", \"sum\"),\n",
        "        total_kg=(\"BranchDeliveryVolumeInKG\", \"sum\"),\n",
        "    )\n",
        "    .reset_index()\n",
        "    .sort_values(by=\"total_cbm\", ascending=False)\n",
        ")\n",
        "section_summary[\"cbm_share_pct\"] = (\n",
        "    section_summary[\"total_cbm\"] / section_summary[\"total_cbm\"].sum()\n",
        ") * 100\n",
        "\n",
        "# 2.4 Demand Breakdown by SA4 (87 SA4 Regions)\n",
        "sa4_summary = df_branch.groupby(['State', 'SA4']).agg(\n",
        "    branch_count=('DestinationRef', 'count'),\n",
        "    total_cbm=('total_cbm', 'sum'),\n",
        "    total_kg=('total_kg', 'sum')\n",
        ").reset_index().sort_values(by='total_cbm', ascending=False)\n",
        "sa4_summary['cbm_share_pct'] = (sa4_summary['total_cbm'] / sa4_summary['total_cbm'].sum()) * 100\n",
        "sa4_summary['cum_cbm_pct'] = sa4_summary['cbm_share_pct'].cumsum()\n",
        "\n",
        "# Plot Top 15 SA4 Regions Chart\n",
        "top15_sa4 = sa4_summary.head(15).sort_values(by='total_cbm', ascending=True)\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.barh(top15_sa4['SA4'], top15_sa4['total_cbm'], color='#2ca02c', alpha=0.85)\n",
        "plt.xlabel('Total CBM Demand', fontsize=11)\n",
        "plt.ylabel('SA4 Region', fontsize=11)\n",
        "plt.title('Top 15 SA4 Regions by CBM Demand', fontsize=13, fontweight='bold', pad=12)\n",
        "plt.tight_layout()\n",
        "plt.savefig('figures/eda_top15_sa4_demand.png', dpi=300)\n",
        "plt.close()\n",
        "# ==========================================\n",
        "# 3. BASELINE REPRODUCTION\n",
        "# ==========================================\n",
        "# Lấy tham số Baseline DC (NSW-DC01)\n",
        "dc_name = df_scenario.loc[0, \"Facility\"]\n",
        "dc_lat = df_scenario.loc[0, \"Latitude\"]\n",
        "dc_lon = df_scenario.loc[0, \"Longitude\"]\n",
        "avg_inv_cbm = df_scenario.loc[0, \"AverageInventoryInCBM\"]\n",
        "storage_rate = df_scenario.loc[0, \"StorageCostPerCBM (AUD)\"]\n",
        "handling_rate = df_scenario.loc[0, \"HandlingCostPerCBM (AUD)\"]\n",
        "\n",
        "\n",
        "# Hàm Haversine Distance (km)\n",
        "def haversine(lat1, lon1, lat2, lon2):\n",
        "    R = 6371.0088\n",
        "    phi1, phi2 = np.radians(lat1), np.radians(lat2)\n",
        "    dphi = np.radians(lat2 - lat1)\n",
        "    dlambda = np.radians(lon2 - lon1)\n",
        "    a = (\n",
        "        np.sin(dphi / 2) ** 2\n",
        "        + np.cos(phi1) * np.cos(phi2) * np.sin(dlambda / 2) ** 2\n",
        "    )\n",
        "    return 2 * R * np.arcsin(np.sqrt(a))\n",
        "\n",
        "\n",
        "# Tính khoảng cách từ NSW-DC01 tới 635 Branches\n",
        "df_branch[\"dist_to_current_dc\"] = haversine(\n",
        "    dc_lat, dc_lon, df_branch[\"Latitude\"], df_branch[\"Longitude\"]\n",
        ")\n",
        "\n",
        "# Hàm tính Cost Curve cho Origin DC tại New South Wales\n",
        "nsw_curves = df_cost[df_cost[\"State\"] == \"New South Wales\"].sort_values(\n",
        "    \"Min Distance (KM)\")\n",
        "\n",
        "\n",
        "def calculate_delivery_cost(distance):\n",
        "    for _, row in nsw_curves.iterrows():\n",
        "        min_d = row[\"Min Distance (KM)\"]\n",
        "        max_d = row[\"Max Distance (KM)\"]\n",
        "        if min_d <= distance < max_d or (distance == max_d):\n",
        "            return row[\"Intercept (AUD)\"] + row[\"Slope (AUD/KM)\"] * distance\n",
        "    last_row = nsw_curves.iloc[-1]\n",
        "    return last_row[\"Intercept (AUD)\"] + last_row[\"Slope (AUD/KM)\"] * distance\n",
        "\n",
        "\n",
        "df_branch[\"baseline_transport_cost\"] = df_branch[\"dist_to_current_dc\"].apply(\n",
        "    calculate_delivery_cost\n",
        ")\n",
        "\n",
        "# Tổng hợp chi phí Baseline\n",
        "total_storage_cost = avg_inv_cbm * storage_rate\n",
        "total_handling_cost = df_branch[\"total_cbm\"].sum() * handling_rate\n",
        "total_transport_cost = df_branch[\"baseline_transport_cost\"].sum()\n",
        "total_baseline_cost = (\n",
        "    total_storage_cost + total_handling_cost + total_transport_cost\n",
        ")\n",
        "\n",
        "# Phân rã chi phí Baseline theo State\n",
        "baseline_by_state = (\n",
        "    df_branch.groupby(\"State\")\n",
        "    .agg(\n",
        "        branch_count=(\"DestinationRef\", \"count\"),\n",
        "        total_cbm=(\"total_cbm\", \"sum\"),\n",
        "        avg_dist_km=(\"dist_to_current_dc\", \"mean\"),\n",
        "        max_dist_km=(\"dist_to_current_dc\", \"max\"),\n",
        "        total_transport_cost=(\"baseline_transport_cost\", \"sum\"),\n",
        "    )\n",
        "    .reset_index()\n",
        "    .sort_values(by=\"total_cbm\", ascending=False)\n",
        ")\n",
        "baseline_by_state[\"avg_transport_cost_per_cbm\"] = (\n",
        "    baseline_by_state[\"total_transport_cost\"] / baseline_by_state[\"total_cbm\"]\n",
        ")\n",
        "# ---------------------------------------------------------\n",
        "# 4. DISTANCE CHECKS (Các bước kiểm tra chất lượng dữ liệu)\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "# Check 1: Kiểm tra xem có khoảng cách nào bị âm hoặc bằ̀ng NaN/Null không\n",
        "missing_dist = df_branch['dist_to_current_dc'].isna().sum()\n",
        "invalid_dist = (df_branch['dist_to_current_dc'] <= 0).sum()\n",
        "\n",
        "print(f\"Số chi nhánh thiếu tọa độ/khoảng cách: {missing_dist}\")\n",
        "print(f\"Số chi nhánh có khoảng cách <= 0 km: {invalid_dist}\")\n",
        "\n",
        "# Check 2: Kiểm tra các giá trị Min, Max, Mean, Median theo từng Bang\n",
        "dist_summary = df_branch.groupby('State')['dist_to_current_dc'].agg(\n",
        "    count='count',\n",
        "    min_km='min',\n",
        "    mean_km='mean',\n",
        "    median_km='median',\n",
        "    max_km='max'\n",
        ").reset_index().sort_values(by='mean_km')\n",
        "\n",
        "print(\"\\n--- BẢNG THỐNG KÊ KHOẢNG CÁCH THEO BANG (KM) ---\")\n",
        "print(dist_summary.to_string(index=False))\n",
        "\n",
        "# Check 3: Kiểm tra các điểm Outliers (Xa bất thường > 3,000 km)\n",
        "far_branches = df_branch[df_branch['dist_to_current_dc'] > 3000]\n",
        "print(f\"\\nSố chi nhánh giao hàng siêu xa (> 3000 km từ NSW): {len(far_branches)}\")\n",
        "\n",
        "# ==========================================\n",
        "# 5. EXPORT TO EXCEL\n",
        "# ==========================================\n",
        "excel_path = \"processed/EDA_and_Baseline_Summary.xlsx\"\n",
        "with pd.ExcelWriter(excel_path) as writer:\n",
        "    state_summary.to_excel(writer, sheet_name=\"EDA_State_Demand\", index=False)\n",
        "    section_summary.to_excel(\n",
        "        writer, sheet_name=\"EDA_Product_Section\", index=False\n",
        "    )\n",
        "    baseline_by_state.to_excel(\n",
        "        writer, sheet_name=\"Baseline_State_Summary\", index=False\n",
        "    )\n",
        "    df_branch[\n",
        "        [\n",
        "            \"DestinationRef\",\n",
        "            \"State\",\n",
        "            \"SA4\",\n",
        "            \"total_cbm\",\n",
        "            \"total_kg\",\n",
        "            \"dist_to_current_dc\",\n",
        "            \"baseline_transport_cost\",\n",
        "        ]\n",
        "    ].to_excel(writer, sheet_name=\"Branch_Baseline_Details\", index=False)\n",
        "\n",
        "print(\"=== HOÀN THÀNH TÍNH TOÁN BASELINE & EDA ===\")\n",
        "print(f\"1. Storage Cost:   AUD {total_storage_cost:,.2f}\")\n",
        "print(f\"2. Handling Cost:  AUD {total_handling_cost:,.2f}\")\n",
        "print(f\"3. Transport Cost: AUD {total_transport_cost:,.2f}\")\n",
        "print(f\"-> TỔNG CHI PHÍ BASELINE: AUD {total_baseline_cost:,.2f}\")\n",
        "print(f\"File tổng hợp kết quả: {excel_path}\")\n",
        "print(f\"Biểu đồ Pareto: figures/eda_pareto_cbm.png\")"
      ],
      "metadata": {
