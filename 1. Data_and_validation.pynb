    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import os\n",
        "\n",
        "# Đảm bảo thư mục lưu trữ tồn tại để tránh lỗi hệ thống\n",
        "output_dir = \"processed\"\n",
        "os.makedirs(output_dir, exist_ok=True)\n",
        "\n",
        "# Gán df_processed_branch từ kết quả tiền xử lý ở ô trước\n",
        "df_processed_branch = processed_df.copy() # FIX: Sử dụng processed_df đã được tạo ở ô 8HBmTLwjcr1A\n",
        "\n",
        "# =====================================================================\n",
        "# BƯỚC 1: XÂY DỰNG TẬP CANDIDATE LOCATIONS (ĐÚNG THEO ĐỀ BÀI)\n",
        "# =====================================================================\n",
        "print(\"[1/5] Đang lọc và xây dựng tập hợp Candidate Hubs...\")\n",
        "\n",
        "# Chuẩn hóa dữ liệu đầu vào (ép kiểu số và xử lý cờ SA4)\n",
        "df_processed_branch[\"total_cbm\"] = pd.to_numeric(df_processed_branch[\"total_cbm\"], errors=\"coerce\").fillna(0)\n",
        "df_processed_branch[\"missing_sa4_flag\"] = df_processed_branch[\"missing_sa4_flag\"].astype(str).str.upper() == \"TRUE\"\n",
        "\n",
        "# Quy tắc 1 & 2: Lọc SA4 không thiếu, lấy branch có CBM lớn nhất mỗi SA4\n",
        "valid_sa4_df = df_processed_branch[~df_processed_branch[\"missing_sa4_flag\"]].copy()\n",
        "max_cbm_indices = valid_sa4_df.groupby(\"SA4\")[\"total_cbm\"].idxmax()\n",
        "candidate_refs = set(valid_sa4_df.loc[max_cbm_indices, \"DestinationRef\"])\n",
        "\n",
        "# Gắn cờ candidate_base_flag vào bảng Master\n",
        "df_processed_branch[\"candidate_base_flag\"] = df_processed_branch[\"DestinationRef\"].isin(candidate_refs)\n",
        "\n",
        "# Quy tắc 4: Loại bỏ tọa độ trùng (Deduplicate) trong tập Candidate\n",
        "df_candidates = df_processed_branch[df_processed_branch[\"candidate_base_flag\"]].copy()\n",
        "\n",
        "# SỬA LỖI LOGIC: Reset index về dạng liên tục sau khi xóa trùng để mảng Numpy đồng bộ\n",
        "df_candidates_unique = df_candidates.drop_duplicates(subset=[\"Longitude\", \"Latitude\"]).copy().reset_index(drop=True)\n",
        "df_branch_cleaned = df_processed_branch.copy().reset_index(drop=True)\n",
        "\n",
        "# Lưu trữ lại dữ liệu Candidate và Master phục vụ lưu vết\n",
        "df_branch_cleaned.to_excel(os.path.join(output_dir, \"Processed_Branch_Master.xlsx\"), index=False)\n",
        "df_candidates_unique.to_excel(os.path.join(output_dir, \"Candidate_Locations.xlsx\"), index=False)\n",
        "\n",
        "# Nạp dữ liệu vào biến chạy thuật toán khoảng cách\n",
        "df_branch = df_branch_cleaned.copy()\n",
        "df_cand = df_candidates_unique.copy()\n",
        "\n",
        "print(f\"--> Số lượng chi nhánh thô (df_branch): {len(df_branch)} dòng.\")\n",
        "print(f\"--> Số lượng ứng viên độc nhất (df_cand): {len(df_cand)} dòng.\")\n",
        "\n",
        "# =====================================================================\n",
        "# BƯỚC 2: HÀM TÍNH KHOẢNG CÁCH HAVERSINE THEO DẠNG MATRIX VECTORIZED\n",
        "# =====================================================================\n",
        "def calculate_haversine_matrix(df_origins, df_destinations, stretch_factor=1.0):\n",
        "    R = 6371.0088  # Bán kính Trái Đất (km)\n",
        "\n",
        "    lat1 = np.radians(df_origins[\"Latitude\"].values)[:, np.newaxis]\n",
        "    lon1 = np.radians(df_origins[\"Longitude\"].values)[:, np.newaxis]\n",
        "    lat2 = np.radians(df_destinations[\"Latitude\"].values)[np.newaxis, :]\n",
        "    lon2 = np.radians(df_destinations[\"Longitude\"].values)[np.newaxis, :]\n",
        "\n",
        "    dlat = lat2 - lat1\n",
        "    dlon = lon2 - lon1\n",
        "\n",
        "    a = (\n",
        "        np.sin(dlat / 2.0) ** 2\n",
        "        + np.cos(lat1) * np.cos(lat2) * np.sin(dlon / 2.0) ** 2\n",
        "    )\n",
        "    c = 2 * np.arcsin(np.sqrt(a))\n",
        "\n",
        "    return R * c * stretch_factor\n",
        "\n",
        "print(\"\\n[4/5] Đang chạy thuật toán ma trận Haversine tối ưu hóa tốc độ...\")\n",
        "dist_matrix = calculate_haversine_matrix(df_branch, df_cand)\n",
        "\n",
        "# =====================================================================\n",
        "# BƯỚC 3: XUẤT ĐỊNH DẠNG MATRIX VÀ PAIRWISE\n",
        "# =====================================================================\n",
        "print(\"\\n[5/5] Đang định dạng cấu trúc bảng Matrix và danh sách Cặp tuyến (Pairwise)...\")\n",
        "\n",
        "# 1. Xuất dạng Matrix (Bảng Ma trận 2 chiều)\n",
        "cand_cols = [f\"Cand_{ref}\" for ref in df_cand[\"DestinationRef\"]]\n",
        "df_dist_matrix = pd.DataFrame(\n",
        "    dist_matrix, index=df_branch[\"DestinationRef\"], columns=cand_cols\n",
        ")\n",
        "df_dist_matrix.index.name = \"DestinationRef_Branch\"\n",
        "df_dist_matrix.to_excel(os.path.join(output_dir, \"Distance_Matrix_Haversine.xlsx\"))\n",
        "\n",
        "# 2. Xuất dạng Pairwise List (Ép phẳng ma trận bằng .melt thay cho vòng lặp để tránh lỗi lệch cột)\n",
        "df_pairwise = df_dist_matrix.reset_index().melt(\n",
        "    id_vars=[\"DestinationRef_Branch\"],\n",
        "    value_vars=cand_cols,\n",
        "    var_name=\"DestinationRef_Candidate\",\n",
        "    value_name=\"Great_Circle_Distance_KM\"\n",
        ")\n",
        "\n",
        "# Chuẩn hóa cột ID Candidate về dạng số nguyên (bỏ tiền tố \"Cand_\")\n",
        "df_pairwise[\"DestinationRef_Candidate\"] = (\n",
        "    df_pairwise[\"DestinationRef_Candidate\"]\n",
        "    .str.replace(\"Cand_\", \"\")\n",
        "    .str.extract('(\\\\d+)', expand=False) # FIX: Extract only numeric part\n",
        "    .astype(int)\n",
        ")\n",
        "\n",
        "# Tính toán Vector cho hệ số kéo dãn S7 trực tiếp trên Series (nhanh gấp trăm lần loop)\n",
        "df_pairwise[\"Distance_Stretch_S7_KM\"] = df_pairwise[\"Great_Circle_Distance_KM\"] * 1.20\n",
        "\n",
        "# Ghi dữ liệu ra file Excel phục vụ Solver\n",
        "df_pairwise.to_excel(os.path.join(output_dir, \"Pairwise_Distances.xlsx\"), index=False)\n",
        "\n",
        "print(\"Đã hoàn thành! Toàn bộ file Matrix và Pairwise đạt độ chính xác tuyệt đối.\")\n",
        "\n",
        "# Chọn ngẫu nhiên hàng đầu tiên để kiểm tra\n",
        "sample_branch = df_branch.iloc[0][\"DestinationRef\"]\n",
        "sample_cand_str = df_cand.iloc[0][\"DestinationRef\"]\n",
        "# FIX: Convert sample_cand to integer by extracting numeric part\n",
        "sample_cand = int(pd.Series(sample_cand_str).str.extract('(\\\\d+)', expand=False).iloc[0])\n",
        "\n",
        "# 1. Lấy khoảng cách từ Bảng Ma trận (Matrix)\n",
        "dist_from_matrix = df_dist_matrix.loc[sample_branch, f\"Cand_{sample_cand_str}\"]\n",
        "\n",
        "# 2. Lấy khoảng cách từ Bảng Cặp tuyến (Pairwise List)\n",
        "dist_from_pairwise = df_pairwise[\n",
        "    (df_pairwise[\"DestinationRef_Branch\"] == sample_branch) &\n",
        "    (df_pairwise[\"DestinationRef_Candidate\"] == sample_cand)\n",
        "][\"Great_Circle_Distance_KM\"].values[0]\n",
        "\n",
        "print(f\"=== KIỂM TRA ĐỘ CHÍNH XÁC ===\")\n",
        "print(f\"Chi nhánh: {sample_branch} | Ứng viên Hub: {sample_cand_str} (Numeric ID: {sample_cand})\")\n",
        "print(f\"-> Khoảng cách trên bảng Matrix  : {dist_from_matrix:.4f} km\")\n",
        "print(f\"-> Khoảng cách trên bảng Pairwise: {dist_from_pairwise:.4f} km\")\n",
        "\n",
        "if np.isclose(dist_from_matrix, dist_from_pairwise):\n",
        "    print(\" HỢP NHẤT CHUẨN XÁC: Kết quả trùng khớp hoàn toàn!\")\n",
        "else:\n",
        "    print(\" LỖI: Kết quả bị lệch nhau!\")"
      ],
