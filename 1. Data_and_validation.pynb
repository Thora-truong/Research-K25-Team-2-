      "cell_type": "code",
      "source": [
        "import os\n",
        "import math\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Đọc file Excel\n",
        "sheets = pd.read_excel(\"Research_Project_Data.xlsx\", sheet_name=None)\n",
        "\n",
        "# Xem tên các sheet\n",
        "print(\"Sheets:\", list(sheets.keys()))\n",
        "\n",
        "# Lấy 2 sheet cần kiểm tra\n",
        "outbound = sheets[\"Outbound\"]\n",
        "branchmaster = sheets[\"BranchMaster\"]\n",
        "\n",
        "# Hàm kiểm tra dữ liệu\n",
        "def check_data(df, sheet_name):\n",
        "\n",
        "    print(\"\\n\" + \"=\"*40)\n",
        "    print(f\"Sheet: {sheet_name}\")\n",
        "    print(\"=\"*40)\n",
        "\n",
        "    # Xem thông tin dữ liệu\n",
        "    df.info()\n",
        "\n",
        "    # 1. Missing values\n",
        "    print(\"\\nMissing values:\")\n",
        "    print(df.isnull().sum())\n",
        "    print(\"Total Missing:\", df.isnull().sum().sum())\n",
        "\n",
        "    # 2. Duplicate rows\n",
        "    print(\"\\nDuplicate rows:\", df.duplicated().sum())\n",
        "\n",
        "    # 3. Duplicate ID\n",
        "    for col in [\"DestinationRef\", \"ShipToID\", \"GroupID\"]:\n",
        "        if col in df.columns:\n",
        "            print(f\"\\n{col}\")\n",
        "            print(\"Missing:\", df[col].isnull().sum())\n",
        "            print(\"Duplicate:\", df[col].duplicated().sum())\n",
        "\n",
        "    # 4. Invalid values\n",
        "    if \"Latitude\" in df.columns:\n",
        "        print(\"\\nInvalid Latitude:\",\n",
        "              ((df[\"Latitude\"] < -90) | (df[\"Latitude\"] > 90)).sum())\n",
        "\n",
        "    if \"Longitude\" in df.columns:\n",
        "        print(\"Invalid Longitude:\",\n",
        "              ((df[\"Longitude\"] < -180) | (df[\"Longitude\"] > 180)).sum())\n",
        "\n",
        "    # 5. Unit check (KG & CBM)\n",
        "    if \"BranchDeliveryVolumeInKG\" in df.columns:\n",
        "        print(\"Negative KG:\",\n",
        "              (df[\"BranchDeliveryVolumeInKG\"] < 0).sum())\n",
        "\n",
        "    if \"BranchDeliveryVolumeInCBM\" in df.columns:\n",
        "        print(\"Negative CBM:\",\n",
        "              (df[\"BranchDeliveryVolumeInCBM\"] < 0).sum())\n",
        "\n",
        "# Chạy kiểm tra cho 2 sheet\n",
        "check_data(outbound, \"Outbound\")\n",
        "check_data(branchmaster, \"BranchMaster\")"
      ],
