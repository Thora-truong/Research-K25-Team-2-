        "import pandas as pd\n",
        "import numpy as np\n",
        "import os\n",
        "\n",
        "\n",
        "def preprocess_branch_data(file_path):\n",
        "    print(\"=\"*50)\n",
        "    print(\"STARTING DATA PREPROCESSING\")\n",
        "    print(\"=\"*50)\n",
        "\n",
        "\n",
        "    #Read Data\n",
        "    print(\"Loading raw data from Excel\")\n",
        "    outbound = pd.read_excel(file_path, sheet_name=\"Outbound\")\n",
        "    branchmaster = pd.read_excel(file_path, sheet_name=\"BranchMaster\")\n",
        "\n",
        "\n",
        "    #Aggregate Demand from Outbound\n",
        "    print(\"Aggregating Outbound data by DestinationRef...\")\n",
        "    outbound[\"is_duplicate\"] = outbound.duplicated(keep=False)\n",
        "\n",
        "\n",
        "    outbound_agg = outbound.groupby(\"DestinationRef\").agg(\n",
        "        total_kg=(\"BranchDeliveryVolumeInKG\", \"sum\"),\n",
        "        total_cbm=(\"BranchDeliveryVolumeInCBM\", \"sum\"),\n",
        "        source_row_count=(\"DestinationRef\", \"count\"),\n",
        "        distinct_section_count=(\"Section\", \"nunique\"),\n",
        "        has_exact_duplicate_rows=(\"is_duplicate\", \"any\")\n",
        "    ).reset_index()\n",
        "\n",
        "\n",
        "    #Join with BranchMaster\n",
        "    print(\"Joining Outbound aggregated data with BranchMaster\")\n",
        "    processed_table = pd.merge(\n",
        "        branchmaster,\n",
        "        outbound_agg,\n",
        "        on=\"DestinationRef\",\n",
        "        how=\"left\"\n",
        "    )\n",
        "\n",
        "\n",
        "    #Handle Missing Values & Duplicate Flags\n",
        "\n",
        "\n",
        "    print(\"Creating validation flags (Missing SA4, Candidates)\")\n",
        "\n",
        "\n",
        "    #missing_sa4_flag\n",
        "    processed_table[\"missing_sa4_flag\"] = processed_table[\"SA4\"].isna()\n",
        "\n",
        "\n",
        "    #candidate_base_flag\n",
        "    processed_table[\"candidate_base_flag\"] = False\n",
        "\n",
        "\n",
        "    valid_sa4_mask = processed_table[\"SA4\"].notna()\n",
        "    idx_max_cbm = processed_table[valid_sa4_mask].groupby(\"SA4\")[\"total_cbm\"].idxmax()\n",
        "\n",
        "\n",
        "    processed_table.loc[idx_max_cbm, \"candidate_base_flag\"] = True\n",
        "\n",
        "\n",
        "    #Coordinate Check\n",
        "    print(\"Verifying coordinates (Australia boundaries)\")\n",
        "\n",
        "\n",
        "    #coordinate_flag:\n",
        "    processed_table[\"coordinate_flag\"] = (\n",
        "        (processed_table[\"Latitude\"] >= 0) |\n",
        "        (processed_table[\"Longitude\"] < 110) |\n",
        "        (processed_table[\"Longitude\"] > 160)\n",
        "    )\n",
        "    #Validation Checks\n",
        "    print(\"\\n\" + \"=\"*50)\n",
        "    print(\"VALIDATION CHECKS\")\n",
        "    print(\"=\"*50)\n",
        "\n",
        "\n",
        "    #Check row count\n",
        "    row_count = len(processed_table)\n",
        "    print(f\"Row count: {row_count} -> {'PASSED' if row_count == 635 else 'FAILED'}\")\n",
        "\n",
        "\n",
        "    #Check for missing DestinationRef after join\n",
        "    missing_dest = processed_table[\"DestinationRef\"].isna().sum()\n",
        "    print(f\"Missing DestinationRef: {missing_dest} -> {'PASSED' if missing_dest == 0 else 'FAILED'}\")\n",
        "\n",
        "\n",
        "    #Check Totals match the original Outbound data\n",
        "    total_kg_original = outbound[\"BranchDeliveryVolumeInKG\"].sum()\n",
        "    total_kg_processed = processed_table[\"total_kg\"].sum()\n",
        "    kg_match = np.isclose(total_kg_original, total_kg_processed)\n",
        "    print(f\"Total KG Match: {kg_match} (Original: {total_kg_original:,.2f}, Processed: {total_kg_processed:,.2f})\")\n",
        "\n",
        "\n",
        "    total_cbm_original = outbound[\"BranchDeliveryVolumeInCBM\"].sum()\n",
        "    total_cbm_processed = processed_table[\"total_cbm\"].sum()\n",
        "    cbm_match = np.isclose(total_cbm_original, total_cbm_processed)\n",
        "    print(f\"Total CBM Match: {cbm_match} (Original: {total_cbm_original:,.2f}, Processed: {total_cbm_processed:,.2f})\")\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "    #Select & Reorder Columns for the Final Export\n",
        "    print(\"Exporting Processed Data...\")\n",
        "    final_columns = [\n",
        "        \"DestinationRef\", \"DestinationType\", \"ShipToID\", \"Longitude\", \"Latitude\",\n",
        "        \"Suburb\", \"City\", \"SA4\", \"State\",\n",
        "        \"total_kg\", \"total_cbm\", \"source_row_count\",\n",
        "        \"distinct_section_count\", \"has_exact_duplicate_rows\",\n",
        "        \"missing_sa4_flag\", \"coordinate_flag\", \"candidate_base_flag\"\n",
        "    ]\n",
        "\n",
        "\n",
        "    #Ensure only existing columns are selected\n",
        "    processed_table = processed_table[[col for col in final_columns if col in processed_table.columns]]\n",
        "\n",
        "\n",
        "    #Save to CSV in a 'processed' directory\n",
        "    output_dir = \"processed\"\n",
        "    os.makedirs(output_dir, exist_ok=True)\n",
        "    output_file = os.path.join(output_dir, \"Processed_Branch_Master.xlsx\")\n",
        "\n",
        "\n",
        "    processed_table.to_excel(output_file, index=False)\n",
        "    print(f\"Processed data saved to: {output_file}\")\n",
        "\n",
        "\n",
        "    return processed_table\n",
        "\n",
        "\n",
        "# Execute the pipeline\n",
        "if __name__ == \"__main__\":\n",
        "    file_name = \"Research_Project_Data.xlsx\"\n",
        "    processed_df = preprocess_branch_data(file_name)\n"
      ],
